# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Secret used by Telegram to sign webhook requests (X-Telegram-Bot-Api-Secret-Token header).
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string
# Public Vercel URL of this deployment (without trailing slash). Used by scripts/set-webhook.ts
PUBLIC_URL=https://your-deployment.vercel.app

# --- Lead Magnet (delivered on /start pin_tracker) ---
# Either a direct file URL or a Telegram file_id / channel post link
LEAD_MAGNET_URL=https://example.com/free-pinterest-guide.pdf
LEAD_MAGNET_TITLE=Free Pinterest Traffic Playbook

# --- Premium offer ---
PREMIUM_PRICE_USDT=15
PREMIUM_PRICE_TON=4.5
PREMIUM_PRICE_RUB=990
PREMIUM_CONTENT_URL=https://example.com/premium-vault

# --- Firebase Admin SDK (service account JSON, base64-encoded) ---
# Generate locally:
#   cat service-account.json | base64 -w0
FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
FIREBASE_PROJECT_ID=your-firebase-project

# --- Crypto Pay (@CryptoBot) ---
# https://help.crypt.bot/crypto-pay-api
CRYPTO_PAY_TOKEN=12345:AAxxxxxxx
# Use https://testnet-pay.crypt.bot/api when developing
CRYPTO_PAY_API_URL=https://pay.crypt.bot/api

# --- Boosty ---
# Secret you configure on Boosty webhook side; we verify the X-Boosty-Signature header.
BOOSTY_WEBHOOK_SECRET=replace-with-long-random-string
# Optional: maps Boosty subscription level IDs to "premium"
BOOSTY_PREMIUM_LEVEL_IDS=12345,67890

# --- Cron ---
# Shared secret protecting /api/cron/* endpoints. Vercel sets `Authorization: Bearer $CRON_SECRET`
# automatically for scheduled invocations.
CRON_SECRET=replace-with-long-random-string
