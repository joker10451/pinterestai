# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF-your-bot-token
# Secret token used in setWebhook for inbound request verification (Telegram sends it as X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=some-long-random-string
BOT_USERNAME=YourBot

# --- Lead Magnet ---
# Either a direct URL the user clicks to receive the freebie,
# or a Telegram file_id pre-uploaded to the bot. If FILE_ID is set, it takes precedence.
LEAD_MAGNET_URL=https://example.com/freebie.pdf
LEAD_MAGNET_FILE_ID=

# --- Premium offer ---
PREMIUM_PRICE_USDT=9.99
PREMIUM_PRICE_TON=3
PREMIUM_BOOSTY_URL=https://boosty.to/yourcreator/purchase/123456?level=42

# --- Firebase (service account, base64-encoded JSON to keep the var single-line on Vercel) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_BASE64=base64-of-service-account-json

# --- Crypto Pay (@CryptoBot) ---
# https://help.crypt.bot/crypto-pay-api
CRYPTO_PAY_TOKEN=12345:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "mainnet" or "testnet"
CRYPTO_PAY_NETWORK=mainnet

# --- Boosty ---
# Shared secret used to validate Boosty webhook signatures.
BOOSTY_WEBHOOK_SECRET=some-shared-secret

# --- Cron security ---
# Vercel sets this automatically for cron requests; we also accept it manually for local testing.
CRON_SECRET=some-cron-secret
